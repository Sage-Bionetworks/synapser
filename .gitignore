# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
*.tar.gz
bin/*
inst/synapseclient*
lib/*

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user
inst/python/__pycache__
inst/bin
inst/lib
inst/synapseclient*
*.Rproj

# produced vignettes
vignettes/*.html
vignettes/*.pdf

.project
.pydevproject
.settings
.DS_Store

synapse.Rproj
inst/doc
*.pyc
.venv
.venv-doc-build

# auto-generated Rd drafts (regenerated locally via tools/createRdFiles.R;
# curated output lives in man/)
auto-man/

# pkgdown generated markdown and LLM docs (build artifacts, not needed in git)
docs/**/*.md
docs/llms.txt
docs/search.json

# scratch pkgdown build output for local preview (see CONTRIBUTING.md); the
# real site lives in docs/ and is committed separately
docs-preview/
